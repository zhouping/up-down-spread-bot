{
  "proxy": "",
  "data_sources": {
    "polymarket": {
      "book_history_dir": "logs/book_history",
      "book_history_interval_sec": 1,
      "gamma_api": "https://gamma-api.polymarket.com",
      "market_interval_sec": 300,
      "market_window": "5m",
      "record_book_history": true,
      "ws_url": "wss://ws-subscriptions-clob.polymarket.com/ws/market"
    }
  },
  "display": {
    "update_interval": 1,
    "width": 160
  },
  "execution": {
    "buy": {
      "max_fak_attempts": 3,
      "min_order_usd": 1,
      "order_type": "FAK",
      "retry_delay_sec": 0.3,
      "target_fill_percent": 98
    },
    "redeem": {
      "api_max_retries": 3,
      "api_retry_delay_sec": 60,
      "api_timeout_sec": 30,
      "check_interval_sec": 300,
      "first_check_delay_sec": 480,
      "gas_limit": 500000,
      "gas_price_multiplier": 1.5,
      "pause_between_redeems_sec": 1,
      "sizeThreshold": 0.1,
      "startup_check_delay_sec": 60,
      "tx_confirmation_timeout_sec": 180
    },
    "rpc_config": {
      "enable_parallel_requests": true,
      "endpoints": [
        "https://polygon-rpc.com"
      ],
      "parallel_timeout_sec": 3,
      "retry_attempts": 10,
      "retry_delay_sec": 0.3,
      "single_request_timeout_sec": 2
    },
    "sell": {
      "chunk_delay_sec": 0.1,
      "chunk_size": 50,
      "delayed_sweep_delay_sec": 1,
      "delayed_sweep_enabled": true,
      "delayed_sweep_fak_attempts": 2,
      "delayed_sweep_fok_attempts": 3,
      "delayed_sweep_min_balance": 0.1,
      "delayed_sweep_retry_delay_sec": 1,
      "max_chunk_retries": 5,
      "min_dust_threshold": 0.1,
      "price": 0.01,
      "strategy": "FOK_CHUNKED",
      "sweep_enable_fallback": true,
      "sweep_fak_attempts": 3,
      "sweep_market_price": 0.01,
      "sweep_max_attempts": 3,
      "sweep_retry_delay_sec": 0.1
    }
  },
  "exit": {
    "flip_stop": {
      "check_realtime": true,
      "enabled": true,
      "price_threshold": 0.4
    },
    "stop_loss": {
      "check_realtime": true,
      "enabled": true,
      "per_coin": {
        "btc": {
          "enabled": true,
          "type": "percent",
          "value": -40
        },
        "eth": {
          "enabled": true,
          "type": "percent",
          "value": -40
        },
        "sol": {
          "enabled": true,
          "type": "percent",
          "value": -40
        },
        "xrp": {
          "enabled": false,
          "type": "fixed",
          "value": -11
        }
      }
    }
  },
  "logging": {
    "session_file": "logs/session.json",
    "trades_file": "logs/trades.jsonl"
  },
  "notifications": {
    "chart_every_n_markets": 10
  },
  "safety": {
    "dry_run": true,
    "max_order_size_usd": 150,
    "max_orders_per_minute": 100,
    "max_total_investment": 1000
  },
  "strategy": {
    "entry_frequency_sec": 30,
    "entry_window_sec": 120,
    "max_entries_per_market": 3,
    "max_investment_per_market": 300,
    "max_investment_per_market_pct": 20,
    "max_spread": 1.05,
    "min_confidence": 0.05,
    "name": "late_entry_v3",
    "price_max": 0.88,
    "sizing": {
      "above_120_sec": 10,
      "above_180_sec": 8,
      "below_120_sec": 12,
      "pct_above_120": 5,
      "pct_above_180": 3,
      "pct_below_120": 8
    }
  },
  "trading": {
    "btc": {
      "enabled": true,
      "reason": ""
    },
    "eth": {
      "enabled": false,
      "reason": "Disabled - only BTC in best window"
    },
    "sol": {
      "enabled": false,
      "reason": "Disabled - only BTC in best window"
    },
    "xrp": {
      "enabled": false,
      "reason": "Disabled by default - less liquid market"
    }
  },
  "trading_fee": {
    "taker_fee_rate": 0.07
  }
}
